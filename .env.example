# Public site URL
NEXT_PUBLIC_SITE_URL=https://blog.malrang.net

# SQLite database path (used by Drizzle in later phases)
DATABASE_URL=./data/blog.db

# Random 32+ character secret used to sign admin sessions (never commit the real value)
SESSION_SECRET=replace-with-a-random-32-character-secret

# Used only by `npm run db:bootstrap-admin`; never commit the real password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
